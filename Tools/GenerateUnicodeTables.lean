import Std.Data.HashMap
import Std.Data.HashSet

/-! `GenerateUnicodeTables <ucd> nfc` prints the source of
`Tyr/Lib/Text/NfcData.lean` to standard output, and
`GenerateUnicodeTables <ucd> categories` that of `Tyr/Lib/Text/UnicodeData.lean`.
`<ucd>` is a directory with `UnicodeData.txt` and `CompositionExclusions.txt`
of one Unicode version, as published under
`https://www.unicode.org/Public/<version>/ucd/`. Hangul syllables have no
decomposition field in `UnicodeData.txt`, so the NFC tables leave them out. -/

open Std

private def hex? (s : String) : Option Nat :=
  if s.isEmpty then none else
    s.foldl (init := some 0) fun acc c => do
      let digit ←
        if c.isDigit then some (c.toNat - '0'.toNat)
        else if 'A' ≤ c ∧ c ≤ 'F' then some (c.toNat - 'A'.toNat + 10)
        else none
      return (← acc) * 16 + digit

private def hexes (values : Array Nat) : String :=
  " ".intercalate (values.toList.map fun v => (String.ofList (Nat.toDigits 16 v)).toUpper)

private structure Entry where
  codePoint : Nat
  /-- The general category, such as `Lu`. -/
  category : String
  /-- `UnicodeData.txt` gives a range of code points with the same properties
  as two lines, named `<…, First>` and `<…, Last>`; this is the first. -/
  startsRange : Bool
  combiningClass : Nat
  /-- The canonical decomposition mapping; empty when there is none. -/
  mapping : Array Nat

private def parseEntry (line : String) : Except String Entry := do
  let bad := s!"UnicodeData.txt: cannot parse '{line}'"
  let codePoint :: name :: category :: combiningClass :: _ :: mapping :: _ := line.splitOn ";"
    | throw bad
  let some codePoint := hex? codePoint | throw bad
  let some combiningClass := combiningClass.toNat? | throw bad
  let entry : Entry :=
    { codePoint, category, startsRange := name.endsWith ", First>", combiningClass, mapping := #[] }
  if mapping.startsWith "<" then return entry
  let parts ← ((mapping.splitOn " ").filter (!·.isEmpty)).mapM fun part =>
    match hex? part with
    | some value => pure value
    | none => throw bad
  return { entry with mapping := parts.toArray }

private def parseExclusions (text : String) : Except String (HashSet Nat) := do
  let mut excluded : HashSet Nat := {}
  for line in text.splitOn "\n" do
    let field := ((line.splitOn "#").head!).trimAscii.toString
    if field.isEmpty then continue
    let some codePoint := hex? field | throw s!"CompositionExclusions.txt: cannot parse '{line}'"
    excluded := excluded.insert codePoint
  return excluded

private partial def expand (mappings : HashMap Nat (Array Nat)) (codePoint : Nat) : Array Nat :=
  match mappings[codePoint]? with
  | some parts => parts.flatMap (expand mappings)
  | none => #[codePoint]

/-- `codePoints` in canonical order (UAX #15): each run of nonzero combining
classes sorted by class, equal classes keeping their order. -/
private def canonicalOrder (combiningClass : Nat → Nat) (codePoints : Array Nat) : Array Nat :=
  let rec insert (x : Nat) : List Nat → List Nat
    | y :: rest =>
        if combiningClass x != 0 && combiningClass y > combiningClass x then y :: insert x rest
        else x :: y :: rest
    | [] => [x]
  (codePoints.foldl (fun reversed x => insert x reversed) []).reverse.toArray

private def renderNfc (version : String) (entries : Array Entry) (excluded : HashSet Nat) : String :=
  let classes : HashMap Nat Nat :=
    entries.foldl (fun acc e => acc.insert e.codePoint e.combiningClass) {}
  let combiningClass (codePoint : Nat) : Nat := classes.getD codePoint 0
  let mappings : HashMap Nat (Array Nat) := entries.foldl (init := {}) fun acc e =>
    if e.mapping.isEmpty then acc else acc.insert e.codePoint e.mapping
  let runs : Array (Nat × Nat × Nat) := entries.foldl (init := #[]) fun runs e =>
    if e.combiningClass == 0 then runs else
      match runs.back? with
      | some (first, last, cls) =>
          if last + 1 == e.codePoint && cls == e.combiningClass then
            runs.pop.push (first, e.codePoint, cls)
          else runs.push (e.codePoint, e.codePoint, e.combiningClass)
      | none => runs.push (e.codePoint, e.codePoint, e.combiningClass)
  let decomposed := entries.filter (!·.mapping.isEmpty)
  let decompositions := decomposed.map fun e =>
    s!"{hexes #[e.codePoint]}:{hexes (canonicalOrder combiningClass (expand mappings e.codePoint))}"
  let compositions := decomposed.filterMap fun e =>
    if e.mapping.size == 2 && e.combiningClass == 0 && combiningClass e.mapping[0]! == 0
        && !excluded.contains e.codePoint then
      some (hexes (e.mapping.push e.codePoint))
    else none
  let join (items : Array String) := ";".intercalate items.toList
  "/-\n  Tyr/Lib/Text/NfcData.lean\n\n" ++
  s!"  Generated by `lake exe GenerateUnicodeTables <ucd> nfc` from Unicode {version}; do not edit.\n" ++
  "  `combiningClasses`: `start end class` runs of nonzero canonical combining\n" ++
  "  class. `decompositions`: `cp:full canonical decomposition`. `compositions`:\n" ++
  "  `first second composite` for each primary composite. Hex, `;`-separated.\n-/\n\n" ++
  "namespace tokenizer.nfc\n\n" ++
  s!"def combiningClasses : String :=\n  \"{join (runs.map fun (first, last, cls) => hexes #[first, last, cls])}\"\n\n" ++
  s!"def decompositions : String :=\n  \"{join decompositions}\"\n\n" ++
  s!"def compositions : String :=\n  \"{join compositions}\"\n\n" ++
  "end tokenizer.nfc\n"

/-- The maximal runs of code points whose general category starts with `major`,
as inclusive ranges in increasing order. -/
private def categoryRanges (entries : Array Entry) (major : Char) : Array (Nat × Nat) := Id.run do
  let mut ranges : Array (Nat × Nat) := #[]
  let mut rangeStart : Option Nat := none
  for entry in entries do
    let first := rangeStart.getD entry.codePoint
    rangeStart := if entry.startsRange then some entry.codePoint else none
    if entry.startsRange || entry.category.front != major then continue
    match ranges.back? with
    | some (start, last) =>
        if last + 1 == first then ranges := ranges.pop.push (start, entry.codePoint)
        else ranges := ranges.push (first, entry.codePoint)
    | none => ranges := ranges.push (first, entry.codePoint)
  return ranges

private def hex6 (value : Nat) : String :=
  let digits := hexes #[value]
  "0x" ++ "".pushn '0' (6 - digits.length) ++ digits

private def renderRanges (ranges : Array (Nat × Nat)) : String :=
  String.join <| (ranges.mapIdx fun i (first, last) =>
    (if i % 6 == 0 then "  " else " ") ++ s!"({hex6 first}, {hex6 last})" ++
    (if i + 1 == ranges.size then "\n" else if i % 6 == 5 then ",\n" else ",")).toList

private def renderCategories (version : String) (entries : Array Entry) : String :=
  "/-\n  Tyr/Lib/Text/UnicodeData.lean\n\n" ++
  s!"  Generated by `lake exe GenerateUnicodeTables <ucd> categories` from Unicode {version}; do not edit.\n" ++
  "  Code points by general category, as sorted, non-overlapping ranges with\n" ++
  "  inclusive ends.\n-/\n\n" ++
  "namespace tokenizer.unicode\n\n" ++
  "/-- General category `L*` (letters). -/\n" ++
  s!"def letterRanges : Array (Nat × Nat) := #[\n{renderRanges (categoryRanges entries 'L')}]\n\n" ++
  "/-- General category `N*` (numbers). -/\n" ++
  s!"def numberRanges : Array (Nat × Nat) := #[\n{renderRanges (categoryRanges entries 'N')}]\n\n" ++
  "end tokenizer.unicode\n"

def main (args : List String) : IO UInt32 := do
  let usage := "usage: GenerateUnicodeTables <ucd> (nfc | categories)"
  let [ucd, table] := args
    | IO.eprintln usage; return 2
  let ucd : System.FilePath := ucd
  let exclusionsText ← IO.FS.readFile (ucd / "CompositionExclusions.txt")
  let dataText ← IO.FS.readFile (ucd / "UnicodeData.txt")
  let firstLine := (exclusionsText.splitOn "\n").head!
  let result : Except String String := do
    let some version := (firstLine.dropPrefix? "# CompositionExclusions-").bind
        (·.dropSuffix? ".txt")
      | throw s!"CompositionExclusions.txt: no version in '{firstLine}'"
    let entries ← ((dataText.splitOn "\n").filter (!·.isEmpty)).mapM parseEntry
    match table with
    | "nfc" => return renderNfc version.toString entries.toArray (← parseExclusions exclusionsText)
    | "categories" => return renderCategories version.toString entries.toArray
    | _ => throw usage
  match result with
  | .ok text => IO.print text; return 0
  | .error message => IO.eprintln message; return 1
