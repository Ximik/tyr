import Tyr.IO.SafeTensors.Record

/-! `GenerateSafeTensorsRecord <source> <Namespace>` prints a Lean module with
the typed record of the tensors in `<source>` (a `.safetensors` file or a model
directory) and a loader for each record type. -/

open torch torch.safetensors

private def shapeLit (shape : Shape) : String :=
  "#[" ++ ", ".intercalate (shape.toList.map toString) ++ "]"

private partial def typeExpr : FieldType → String
  | .tensor dtype shape => s!"Tensor ⟨{shapeLit shape}, .{dtype.canonicalName}, device⟩"
  | .record name => s!"{name} device"
  | .array elem _ => s!"Array ({typeExpr elem})"

/-- `depth` counts the enclosing arrays; each binds its own index. -/
private partial def loadExpr (name : String) (depth : Nat := 0) : FieldType → String
  | .tensor dtype shape => s!"src.loadAs {name} ⟨{shapeLit shape}, .{dtype.canonicalName}⟩ device"
  | .record type => s!"{type}.load src {name} device"
  | .array elem count =>
      let index := if depth == 0 then "i" else s!"i{depth}"
      s!"(Array.range {count}).mapM fun {index} => " ++
        loadExpr s!"(childName {name} (toString {index}))" (depth + 1) elem

private def fieldName (field : Field) : String :=
  match field.segment with
  | some segment => s!"(childName name {segment.quote})"
  | none => "name"

private def renderType (type : RecordType) : String :=
  let fields := type.fields.toList.map fun field => s!"  {field.name} : {typeExpr field.type}\n"
  let loads := type.fields.toList.map fun field =>
    s!"    {field.name} := ← {loadExpr (fieldName field) 0 field.type}"
  s!"structure {type.name} (device : Device := .CPU) where\n" ++ String.join fields ++
    "  deriving TensorStruct\n\n" ++
    s!"def {type.name}.load (src : Source) (name : String) (device : Device := .CPU) :\n" ++
    s!"    IO ({type.name} device) := do\n" ++
    "  return {\n" ++ ",\n".intercalate loads ++ " }\n"

private def renderModule (command namespaceName : String) (record : Record) : String :=
  s!"-- Generated by `{command}`; do not edit.\n" ++
  "import Tyr.IO.SafeTensors.Source\nimport Tyr.Core.TensorStruct.Derive\n\n" ++
  s!"namespace {namespaceName}\n\nopen torch torch.safetensors\n\n" ++
  "\n".intercalate (record.types.toList.map renderType) ++
  s!"\nend {namespaceName}\n"

def main (args : List String) : IO UInt32 := do
  let [source, namespaceName] := args
    | IO.eprintln "usage: GenerateSafeTensorsRecord <source> <Namespace>"; return 2
  match Record.ofSchema (← introspect source).tensors with
  | .ok record =>
      IO.print (renderModule s!"lake exe GenerateSafeTensorsRecord {source} {namespaceName}" namespaceName record)
      return 0
  | .error message => IO.eprintln message; return 1
