# Symbols libTyrC.dylib exports. Only Tyr's own prefixes: with
# `-undefined dynamic_lookup` a bare _lean_* would also match the Lean runtime
# functions libTyrC calls, which ld turns into re-exports that dyld rejects.
_lean_torch_*
_lean_launch_*
_lean_tyr_*
_lean_float_buffer_*
_lean_parquet_*
__ZN7tyr_ops*
