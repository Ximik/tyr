import Tests.Devices
/-
  Tests/TestSafeTensorsRecord.lean

  Coverage for SafeTensors schema introspection and the records generated by
  `GenerateSafeTensorsRecord` (`Tests/SafeTensorsRecords/`).
-/
import Tests.Assertions
import Tests.SafeTensorsRecords.Single
import Tests.SafeTensorsRecords.Sharded
import Tests.SafeTensorsRecords.Indexed
import Tests.SafeTensorsRecords.IndexedDir
import Tests.SafeTensorsRecords.Nested
import Tests.SafeTensorsRecords.NonUniform
import Tests.SafeTensorsRecords.Traversal
import Tyr.IO.SafeTensors.Record
import LeanTest

open torch

private def fixture (name : String) : String := s!"Tests/fixtures/safetensors/{name}"

-- Generated records expose traversal capabilities from their declared leaf types.
example : TensorStruct TraversalSafe.Weights := inferInstance
example : FloatingTensorStruct TraversalSafe.WeightsWeights := inferInstance
example : True := by
  fail_if_success
    have _ : FloatingTensorStruct TraversalSafe.Weights := inferInstance
  trivial

@[test] def testSafeTensorsRecordTraversalCapabilities : IO Unit := do
  let weights ← TraversalSafe.Weights.load (← safetensors.Source.open (fixture "traversal.safetensors")) ""
  let doubled := TensorStruct.scale weights.weights 2.0
  LeanTest.assertEqual (← doubled.left.toFloatArray) #[2.0, 4.0]
  LeanTest.assertEqual (← doubled.right.toFloatArray) #[6.0]
  let combined := Tensor.add weights.weights.left doubled.left
  LeanTest.assertEqual (← combined.toFloatArray) #[3.0, 6.0]
  let detached := TensorStruct.detach weights
  LeanTest.assertEqual (← detached.step.toFloatArray) #[7.0]

-- Generated records carry the stored shape and dtype in their field types.
example (weights : SingleSafe.Weights) : Tensor ⟨#[2, 3], .Float32, .CPU⟩ := weights.linear.weight
example (_weights : SingleSafe.Weights) : True := by
  fail_if_success
    have _badShape : Tensor { shape := #[2, 4], dtype := .Float32, device := .CPU } := _weights.linear.weight
  fail_if_success
    have _badDtype : Tensor { shape := #[2, 3], dtype := .Int64, device := .CPU } := _weights.linear.weight
  trivial

private def writeBinCopy (src dst : String) : IO Unit := do
  let bytes ← IO.FS.readBinFile src
  IO.FS.writeBinFile ⟨dst⟩ bytes

private def writeIndexDir (name indexJson : String) : IO String := do
  let dir := s!"/tmp/tyr_safetensors_{name}"
  IO.FS.createDirAll ⟨dir⟩
  IO.FS.writeFile s!"{dir}/model.safetensors.index.json" indexJson
  pure dir

private def tensorValues (t : RawTensor) : Array Float :=
  (t.getValues 1024).data

private def headerPrefix (size : UInt64) : ByteArray := Id.run do
  let mut result := ByteArray.empty
  for i in [:8] do
    result := result.push ((size >>> (i * 8).toUInt64).toUInt8)
  pure result

@[test]
def testSafeTensorsHeaderReadBounds : IO Unit := IO.FS.withTempDir fun dir => do
  let path := (dir / "bounded.safetensors").toString
  IO.FS.writeBinFile path (ByteArray.mk #[1, 2, 3])
  Tests.assertThrows (safetensors.introspect path) (some "missing 8-byte header size")
  IO.FS.writeBinFile path (headerPrefix 4096)
  Tests.assertThrows (safetensors.introspect path) (some "header exceeds file size")
  IO.FS.writeBinFile path (headerPrefix (safetensors.maxHeaderBytes + 1).toUInt64)
  Tests.assertThrows (safetensors.introspect path) (some "byte limit")
  let header := "{\"x\":{\"dtype\":\"F32\",\"shape\":[1],\"data_offsets\":[0,4]}}".toUTF8
  -- Payload bytes are deliberately not UTF-8 and must not enter JSON parsing.
  IO.FS.writeBinFile path (headerPrefix header.size.toUInt64 ++ header ++ ByteArray.mk #[255, 254, 253, 252])
  let schema ← safetensors.introspect path
  LeanTest.assertEqual schema.tensors.size 1
  LeanTest.assertTrue ((schema.find? "x").isSome)

@[test]
def testSafeTensorsIntrospectionSingle : IO Unit := do
  let schema ← safetensors.introspect "Tests/fixtures/safetensors/single.safetensors"
  LeanTest.assertEqual schema.sourceIsDirectory false "single source should not be a directory"
  LeanTest.assertEqual schema.tensors.size 1 "single fixture should have one tensor"

  let some tensor := schema.find? "linear.weight"
    | throw <| IO.userError "expected tensor 'linear.weight'"
  LeanTest.assertEqual tensor.dtype DType.Float32 "dtype should be parsed into core DType"
  LeanTest.assertTrue (tensor.shape == #[2, 3]) "shape should match safetensors header"
  LeanTest.assertEqual tensor.sourceFile "" "single-file introspection should use empty sourceFile"

@[test]
def testSafeTensorsIntrospectionSharded : IO Unit := do
  let schema ← safetensors.introspect "Tests/fixtures/safetensors/sharded"
  LeanTest.assertEqual schema.sourceIsDirectory true "sharded source should be a directory"
  LeanTest.assertEqual schema.tensors.size 2 "sharded fixture should have two tensors"

  let some embed := schema.find? "embed.weight"
    | throw <| IO.userError "expected tensor 'embed.weight'"
  LeanTest.assertEqual embed.sourceFile "part1.safetensors" "embed tensor should map to part1 shard"
  LeanTest.assertTrue (embed.shape == #[2, 2]) "embed tensor shape should match header"

  let some bias := schema.find? "proj.bias"
    | throw <| IO.userError "expected tensor 'proj.bias'"
  LeanTest.assertEqual bias.sourceFile "part2.safetensors" "bias tensor should map to part2 shard"
  LeanTest.assertTrue (bias.shape == #[3]) "bias tensor shape should match header"

@[test]
def testSafeTensorsIntrospectionShardedIndexJson : IO Unit := do
  let schema ← safetensors.introspect "Tests/fixtures/safetensors/indexed_dir"
  LeanTest.assertEqual schema.sourceIsDirectory true "indexed sharded source should be a directory"
  LeanTest.assertEqual schema.tensors.size 2 "weight_map should define exactly two tensors"

  let some embed := schema.find? "embed.weight"
    | throw <| IO.userError "expected tensor 'embed.weight'"
  LeanTest.assertEqual embed.sourceFile "part1.safetensors" "embed tensor should map through index json"

  let some bias := schema.find? "proj.bias"
    | throw <| IO.userError "expected tensor 'proj.bias'"
  LeanTest.assertEqual bias.sourceFile "part2.safetensors" "proj.bias tensor should map through index json"

  let unmapped := schema.find? "linear.weight"
  LeanTest.assertTrue unmapped.isNone "tensors from unmapped shard files should not be exposed"

@[test]
def testSafeTensorsIntrospectionIndexValidationErrors : IO Unit := do
  let missingWeightMapDir ← writeIndexDir
    "index_missing_weight_map"
    "{\"metadata\":{}}"
  Tests.assertThrows
    (safetensors.introspect missingWeightMapDir)
    (some "missing 'weight_map'")

  let nonObjectWeightMapDir ← writeIndexDir
    "index_non_object_weight_map"
    "{\"weight_map\":[]}"
  Tests.assertThrows
    (safetensors.introspect nonObjectWeightMapDir)
    (some "'weight_map' must be a JSON object")

  let nonStringWeightMapDir ← writeIndexDir
    "index_non_string_weight_map"
    "{\"weight_map\":{\"embed.weight\":123}}"
  Tests.assertThrows
    (safetensors.introspect nonStringWeightMapDir)
    (some "has non-string shard filename")

  let missingShardDir ← writeIndexDir
    "index_missing_shard"
    "{\"weight_map\":{\"embed.weight\":\"missing-shard-does-not-exist.safetensors\"}}"
  Tests.assertThrows
    (safetensors.introspect missingShardDir)
    (some "referenced shard does not exist")

  let missingTensorDir ← writeIndexDir
    "index_missing_tensor"
    "{\"weight_map\":{\"proj.bias\":\"part1.safetensors\"}}"
  writeBinCopy
    "Tests/fixtures/safetensors/sharded/part1.safetensors"
    s!"{missingTensorDir}/part1.safetensors"
  Tests.assertThrows
    (safetensors.introspect missingTensorDir)
    (some "tensor 'proj.bias' not found in shard 'part1.safetensors'")

@[test]
def testSafeTensorsIntrospectionIndexPathSafety : IO Unit := do
  let traversalDir ← writeIndexDir
    "index_unsafe_traversal"
    "{\"weight_map\":{\"embed.weight\":\"../part1.safetensors\"}}"
  Tests.assertThrows
    (safetensors.introspect traversalDir)
    (some "unsafe shard path")

  let absoluteDir ← writeIndexDir
    "index_unsafe_absolute"
    "{\"weight_map\":{\"embed.weight\":\"/tmp/evil.safetensors\"}}"
  Tests.assertThrows
    (safetensors.introspect absoluteDir)
    (some "unsafe shard path")

@[test]
def testSafeTensorsRecordSingle : IO Unit := do
  let src ← safetensors.Source.open (fixture "single.safetensors")
  let weights ← SingleSafe.Weights.load src ""
  LeanTest.assertTrue (weights.linear.weight.runtimeShape == #[2, 3])
    "the record should expose nested typed tensor fields"
  let linear ← SingleSafe.WeightsLinear.load src "linear"
  LeanTest.assertTrue (linear.weight.runtimeShape == #[2, 3]) "a subtree should load on its own"
  Tests.assertThrows (discard <| src.loadAs "linear.weight" ⟨#[2, 3], .BFloat16⟩) (some "Expected dtype")

@[test]
def testSafeTensorsRecordSharded : IO Unit := do
  let weights ← ShardedSafe.Weights.load (← safetensors.Source.open (fixture "sharded")) ""
  LeanTest.assertTrue (weights.embed.weight.runtimeShape == #[2, 2]) "embed should load from its shard"
  LeanTest.assertTrue (weights.proj.bias.runtimeShape == #[3]) "bias should load from its shard"

@[test]
def testSafeTensorsRecordIndexedHierarchy : IO Unit := do
  let src ← safetensors.Source.open (fixture "indexed.safetensors")
  let direct0 ← src.loadAs "layers.0.weight" ⟨#[2], .Float32⟩
  let direct1 ← src.loadAs "layers.1.weight" ⟨#[2], .Float32⟩
  LeanTest.assertTrue (tensorValues direct0.raw != tensorValues direct1.raw)
    "indexed fixture should use distinct tensor values across numeric siblings"
  let weights ← IndexedSafe.Weights.load src ""
  LeanTest.assertEqual weights.layers.size 2 "numeric path segments should produce an array"
  let some layer0 := weights.layers[0]?
    | throw <| IO.userError "expected first indexed layer"
  let some layer1 := weights.layers[1]?
    | throw <| IO.userError "expected second indexed layer"
  LeanTest.assertTrue (tensorValues layer0.weight.raw == tensorValues direct0.raw)
    "the array should hold the first indexed tensor"
  LeanTest.assertTrue (tensorValues layer1.weight.raw == tensorValues direct1.raw)
    "the array should hold later indexed tensors instead of repeating the first"

@[test]
def testSafeTensorsRecordNestedArrays : IO Unit := do
  let weights ← NestedSafe.Weights.load (← safetensors.Source.open (fixture "nested.safetensors")) ""
  let values ← weights.blocks.mapM fun row => row.mapM fun item => item.weight.toFloatArray
  LeanTest.assertEqual values #[#[#[0.0], #[1.0], #[2.0]], #[#[10.0], #[11.0], #[12.0]]]
    "blocks.i.j.weight holds 10 * i + j"

@[test]
def testSafeTensorsRecordShardedIndexJson : IO Unit := do
  let weights ← IndexedDirSafe.Weights.load (← safetensors.Source.open (fixture "indexed_dir")) ""
  LeanTest.assertTrue (weights.embed.weight.runtimeShape == #[2, 2])
    "an index-backed record should load embed from its mapped shard"
  LeanTest.assertTrue (weights.proj.bias.runtimeShape == #[3])
    "an index-backed record should load proj bias from its mapped shard"

@[test]
def testSafeTensorsRecordNonUniformIndexedHierarchy : IO Unit := do
  let weights ← NonUniformSafe.Weights.load
    (← safetensors.Source.open (fixture "provider_errors/nonuniform.safetensors")) ""
  LeanTest.assertTrue (weights.layers.i0.weight.runtimeShape == #[1])
    "non-uniform numeric siblings should become named index fields"
  LeanTest.assertTrue (weights.layers.i1.weight.runtimeShape == #[2])
    "non-uniform indexed subtree should retain later numeric siblings"

@[test]
def testSafeTensorsRecordRejectsNonContiguousIndices : IO Unit := do
  let schema ← safetensors.introspect (fixture "provider_errors/noncontiguous.safetensors")
  match safetensors.Record.ofSchema schema.tensors with
  | .ok _ => throw <| IO.userError "a gap in numeric segments must not build a record"
  | .error message =>
      LeanTest.assertTrue ((message.splitOn "non-contiguous numeric path segment under 'layers'").length > 1)
        s!"unexpected error: {message}"

/-- A generated loader enforces dtype, not just the header shape. -/
@[test]
def testSafeTensorsRecordRejectsDtype : IO Unit := IO.FS.withTempDir fun dir => do
  let path := (dir / "wrong-dtype.safetensors").toString
  let header := "{\"linear.weight\":{\"dtype\":\"I32\",\"shape\":[2,3],\"data_offsets\":[0,24]}}".toUTF8
  IO.FS.writeBinFile path
    (headerPrefix header.size.toUInt64 ++ header ++ ByteArray.mk (Array.replicate 24 0))
  Tests.assertThrows (discard <| SingleSafe.Weights.load (← safetensors.Source.open path) "") (some "dtype")

/-- Equal element counts must not permit a different stored layout. -/
@[test]
def testSafeTensorsContractRejectsReshapedLayout : IO Unit := do
  let path := "Tests/fixtures/safetensors/single.safetensors"
  Tests.assertThrows
    (do
      let src ← safetensors.Source.open path
      discard <| src.loadAs "linear.weight" ⟨#[3, 2], .Float32⟩)
    (some "shape")
  Tests.assertThrows
    (do
      let src ← safetensors.Source.open "Tests/fixtures/safetensors/sharded"
      discard <| src.loadAs "embed.weight" ⟨#[1, 4], .Float32⟩)
    (some "shape")
