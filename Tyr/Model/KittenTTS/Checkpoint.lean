  gamma : Tensor ⟨#[512], .Float32, device⟩
  deriving TensorStruct

def WeightsTextencoderCnnItemI1.load (src : Source) (name : String) (device : Device := .CPU) :
    IO (WeightsTextencoderCnnItemI1 device) := do
  return {
    beta := ← src.loadAs (childName name "beta") ⟨#[512], .Float32⟩ device,
    gamma := ← src.loadAs (childName name "gamma") ⟨#[512], .Float32⟩ device }

structure WeightsTextencoderCnnItem (device : Device := .CPU) where
  i0 : WeightsTextencoderCnnItemI0 device
  i1 : WeightsTextencoderCnnItemI1 device
  deriving TensorStruct

def WeightsTextencoderCnnItem.load (src : Source) (name : String) (device : Device := .CPU) :
    IO (WeightsTextencoderCnnItem device) := do
  return {
    i0 := ← WeightsTextencoderCnnItemI0.load src (childName name "0") device,
    i1 := ← WeightsTextencoderCnnItemI1.load src (childName name "1") device }

structure WeightsTextencoderEmbedding (device : Device := .CPU) where
  weight : Tensor ⟨#[178, 512], .Float32, device⟩
  deriving TensorStruct

def WeightsTextencoderEmbedding.load (src : Source) (name : String) (device : Device := .CPU) :
    IO (WeightsTextencoderEmbedding device) := do
  return {
    weight := ← src.loadAs (childName name "weight") ⟨#[178, 512], .Float32⟩ device }

structure WeightsTextencoderLstm (device : Device := .CPU) where
  bias_hh_l0 : Tensor ⟨#[1024], .Float32, device⟩
  bias_hh_l0_reverse : Tensor ⟨#[1024], .Float32, device⟩
  bias_ih_l0 : Tensor ⟨#[1024], .Float32, device⟩
  bias_ih_l0_reverse : Tensor ⟨#[1024], .Float32, device⟩
  weight_hh_l0 : Tensor ⟨#[1024, 256], .Float32, device⟩
  weight_hh_l0_reverse : Tensor ⟨#[1024, 256], .Float32, device⟩
  weight_ih_l0 : Tensor ⟨#[1024, 512], .Float32, device⟩
  weight_ih_l0_reverse : Tensor ⟨#[1024, 512], .Float32, device⟩
  deriving TensorStruct

def WeightsTextencoderLstm.load (src : Source) (name : String) (device : Device := .CPU) :
    IO (WeightsTextencoderLstm device) := do
  return {
    bias_hh_l0 := ← src.loadAs (childName name "bias_hh_l0") ⟨#[1024], .Float32⟩ device,
    bias_hh_l0_reverse := ← src.loadAs (childName name "bias_hh_l0_reverse") ⟨#[1024], .Float32⟩ device,
    bias_ih_l0 := ← src.loadAs (childName name "bias_ih_l0") ⟨#[1024], .Float32⟩ device,
    bias_ih_l0_reverse := ← src.loadAs (childName name "bias_ih_l0_reverse") ⟨#[1024], .Float32⟩ device,
    weight_hh_l0 := ← src.loadAs (childName name "weight_hh_l0") ⟨#[1024, 256], .Float32⟩ device,
    weight_hh_l0_reverse := ← src.loadAs (childName name "weight_hh_l0_reverse") ⟨#[1024, 256], .Float32⟩ device,
    weight_ih_l0 := ← src.loadAs (childName name "weight_ih_l0") ⟨#[1024, 512], .Float32⟩ device,
    weight_ih_l0_reverse := ← src.loadAs (childName name "weight_ih_l0_reverse") ⟨#[1024, 512], .Float32⟩ device }

structure WeightsTextencoder (device : Device := .CPU) where
  cnn : Array (WeightsTextencoderCnnItem device)
  embedding : WeightsTextencoderEmbedding device
  lstm : WeightsTextencoderLstm device
  deriving TensorStruct

def WeightsTextencoder.load (src : Source) (name : String) (device : Device := .CPU) :
    IO (WeightsTextencoder device) := do
  return {
    cnn := ← (Array.range 3).mapM fun i => WeightsTextencoderCnnItem.load src (childName (childName name "cnn") (toString i)) device,
    embedding := ← WeightsTextencoderEmbedding.load src (childName name "embedding") device,
    lstm := ← WeightsTextencoderLstm.load src (childName name "lstm") device }

structure Weights (device : Device := .CPU) where
  bert : WeightsBert device
  bert_encoder : WeightsBertencoder device
  decoder : WeightsDecoder device
  predictor : WeightsPredictor device
  text_encoder : WeightsTextencoder device
  deriving TensorStruct

def Weights.load (src : Source) (name : String) (device : Device := .CPU) :
    IO (Weights device) := do
  return {
    bert := ← WeightsBert.load src (childName name "bert") device,
    bert_encoder := ← WeightsBertencoder.load src (childName name "bert_encoder") device,
    decoder := ← WeightsDecoder.load src (childName name "decoder") device,
    predictor := ← WeightsPredictor.load src (childName name "predictor") device,
    text_encoder := ← WeightsTextencoder.load src (childName name "text_encoder") device }

