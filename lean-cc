#!/usr/bin/env bash
# LEAN_CC for Linux: build Lean's generated C with the system gcc instead of
# Lean's bundled clang.
#
# Lean's bundled clang links against the old glibc inside the Lean toolchain,
# but Tyr's C++ (cc/) and libtorch are built with the system gcc and need the
# system glibc/libstdc++. Lake has no lakefile option for the C compiler, so
# this is selected with `export LEAN_CC=$PWD/lean-cc` (`source ./env.sh` does it).
#
# With a custom LEAN_CC, Lake still passes Lean's runtime link flags
# (-lc++, -lc++abi, -lgmp, -luv). Those libraries exist only inside the Lean
# toolchain, so they are mapped to its static archives here.
#
# Optional environment:
#   LEAN_CC_GCC     compiler to run (default: gcc from PATH)
#   LEAN_CC_FAST=1  compile Lean-generated C with -O0 for fast iteration
#   LEAN_CC_LINKER  linker for link steps (default: the toolchain's lld)
set -euo pipefail

sysroot="${LEAN_SYSROOT:-$(lean --print-prefix)}"
gcc_bin="${LEAN_CC_GCC:-gcc}"

is_compile=0
for arg in "$@"; do
  if [[ "$arg" == "-c" ]]; then
    is_compile=1
    break
  fi
done

args=()
for arg in "$@"; do
  case "$arg" in
    -lc++ | -lc++abi | -lgmp)
      args+=("${sysroot}/lib/lib${arg#-l}.a")
      ;;
    -luv)
      args+=("-Wl,--whole-archive" "${sysroot}/lib/libuv.a" "-Wl,--no-whole-archive")
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

if [[ "$is_compile" -eq 1 ]]; then
  # Lean passes -O3; a later -O0 wins.
  if [[ "${LEAN_CC_FAST:-0}" == "1" ]]; then
    args+=("-O0")
  fi
else
  linker="${LEAN_CC_LINKER-lld}"
  if [[ "$linker" == lld ]]; then
    # lld is much faster than bfd on these large links; use the toolchain's copy.
    args+=("-B${sysroot}/bin" "-fuse-ld=lld")
  elif [[ -n "$linker" ]]; then
    args+=("-fuse-ld=${linker}")
  fi
fi

exec "$gcc_bin" "${args[@]}"
